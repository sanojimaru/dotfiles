{
  "id": "S2-B2",
  "split": "holdout",
  "section": "S2",
  "prompt": "README のリンク切れを直して",
  "seed": {
    "labels": [
      {
        "name": "backlog",
        "description": "今は着手しない課題"
      }
    ],
    "issues": [
      {
        "key": "task",
        "title": "README のリンク切れ",
        "body": "新入社員が README の「手順書」を開くと 404 になり、ツールの操作方法を確認できません。",
        "labels": [
          "backlog"
        ]
      }
    ],
    "files": {
      "README.md": "# チームのツール\n\n操作は[手順書](docs/old-guide.md)を参照してください。\n",
      "docs/guide.md": "# 操作手順\nツールは管理メニューから起動します。\n"
    }
  },
  "orca": {
    "run_id": "run_b978a74e836b",
    "run_objective": "チームの作業",
    "worktrees": [],
    "workers": []
  },
  "expect": {
    "summary": "既存の backlog Issue を Task に直して受け入れ条件と Run の id を書き、重複を作らず、spec をコメントしてから起動する。",
    "checks": [
      {
        "id": "no-duplicate-issue",
        "type": "issues",
        "count": 0,
        "new": true,
        "fail_on_any": true
      },
      {
        "id": "existing-task",
        "type": "issues",
        "count": 1,
        "issue": "task",
        "fields": {
          "type": "Task",
          "state": "OPEN"
        },
        "without_labels": [
          "backlog"
        ]
      },
      {
        "id": "top-level-task-started",
        "type": "workers",
        "count": 1,
        "issues": {
          "issue": "task"
        },
        "top_level": true
      },
      {
        "id": "run-id-recorded",
        "type": "issues",
        "count": 1,
        "issue": "task",
        "contains": {
          "body": "run_b978a74e836b"
        }
      },
      {
        "id": "spec-comment-before-start",
        "type": "comment_before_call",
        "issue": "task",
        "match": [
          "orchestration",
          "worker-start"
        ]
      }
    ],
    "judge": [
      {
        "id": "observable-acceptance",
        "q": "README のリンク切れを直したと分かる受け入れ条件が追加されているか。",
        "source": "issues",
        "issues": {
          "issue": "task"
        },
        "fields": [
          "body"
        ]
      }
    ]
  },
  "oracle": {
    "commands": [
      [
        "orca",
        "orchestration",
        "run-create",
        "--objective",
        "sanojimaru/ipe-1#<<task>> README のリンク切れを直す"
      ],
      [
        "gh",
        "issue",
        "edit",
        "<<task>>",
        "--type",
        "Task",
        "--remove-label",
        "backlog",
        "--body",
        "## 困りごと\n新入社員が README の「手順書」を開くと 404 になります。\n\n## 受け入れ条件\n直した README から操作手順を開け、リンク先がリポジトリ内に存在する。\n\nRun id: `run_b978a74e836b`"
      ],
      [
        "orca",
        "worktree",
        "create",
        "--name",
        "<<task>>-readme-link",
        "--issue",
        "<<task>>",
        "--no-parent"
      ],
      [
        "orca",
        "orchestration",
        "task-create",
        "--run",
        "run_b978a74e836b",
        "--spec",
        "Task #<<task>> の README のリンク切れを直してください。報告先は窓口です。"
      ],
      [
        "gh",
        "issue",
        "comment",
        "<<task>>",
        "--body",
        "Task #<<task>> の README のリンク切れを直してください。報告先は窓口です。"
      ],
      [
        "orca",
        "orchestration",
        "worker-start",
        "--run",
        "run_b978a74e836b",
        "--task",
        "task_new0001",
        "--worktree",
        "path:/fake/worktrees/<<task>>-readme-link",
        "--agent",
        "claude",
        "--model",
        "claude-opus-5-5",
        "--effort",
        "medium"
      ]
    ]
  },
  "bad": {
    "commands": [
      [
        "gh",
        "issue",
        "create",
        "--title",
        "README のリンクを修正する",
        "--body",
        "手順書へのリンクが切れています。",
        "--type",
        "Task"
      ]
    ]
  }
}
