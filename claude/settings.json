{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(pwd)",
      "Bash(tree *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(diff *)",
      "Bash(less *)",
      "Bash(more *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(readlink *)",
      "Bash(mise *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git tag*)",
      "Bash(git blame*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git config --list*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python3 *)",
      "Bash(mise exec *)",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status",
      "Bash(aws sso login *)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git reset *--hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean * -f)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm * -rf)",
      "Bash(rm * -fr)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sanojimaru/.claude/hooks/worktree-branch-cleanup.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": []
      }
    ]
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": false,
    "code-review@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "common@helix": true,
    "development@helix": true,
    "knowledge-graph@helix": true,
    "agent-builder@helix": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "helix": {
      "source": {
        "source": "git",
        "url": "https://github.com/spikestudio/helix.git"
      },
      "autoUpdate": true
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": false
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "advisorModel": "fable",
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {}
}
