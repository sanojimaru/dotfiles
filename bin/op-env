#!/usr/bin/env bash
# 1Password の Service Account でキーを読み、カレントディレクトリの .env に書く (既存の同名キーは置き換える)。
# 使い方: op-env KEY [KEY...]   — op://$OP_ENV_VAULT/<KEY>/credential を読む (vault の既定は Dev)
# トークンは ~/.config/op/service-account-token (600) に置く。OP_SERVICE_ACCOUNT_TOKEN をグローバルに
# export しないのは、手元で使う op (デスクトップアプリ連携・Personal vault) が Service Account 側に切り替わるため。
set -euo pipefail

[ $# -gt 0 ] || { echo "usage: op-env KEY [KEY...]" >&2; exit 2; }
for key in "$@"; do
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "op-env: キー名が不正: $key" >&2; exit 2; }
done

token_file="${OP_ENV_TOKEN_FILE:-$HOME/.config/op/service-account-token}"
vault="${OP_ENV_VAULT:-Dev}"
[ -r "$token_file" ] || { echo "op-env: トークンが無い: $token_file" >&2; exit 1; }
OP_SERVICE_ACCOUNT_TOKEN="$(cat "$token_file")"
export OP_SERVICE_ACCOUNT_TOKEN

umask 077
tmp="$(mktemp .env.op-env.XXXXXX)"
trap 'rm -f "$tmp"' EXIT

# 既存の .env から、これから書くキーの行だけ除いて引き継ぐ
if [ -f .env ]; then
  grep -v -E "^(export[[:space:]]+)?($(IFS='|'; echo "$*"))=" .env > "$tmp" || true
fi

missing=()
for key in "$@"; do
  # 失敗時の op のメッセージには値が含まれないので、そのまま出す
  if value="$(op read "op://$vault/$key/credential")"; then
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
  else
    missing+=("$key")
  fi
done

if [ ${#missing[@]} -gt 0 ]; then
  echo "op-env: 読めなかったキー (vault: $vault): ${missing[*]} — .env は変更していない" >&2
  exit 1
fi

mv "$tmp" .env
chmod 600 .env
echo "op-env: .env に書いた: $*"
