#!/usr/bin/env bash
# 1Password の Service Account でキーを読み、カレントディレクトリの .env に書く (既存の同名キーは置き換える)。
# 使い方: op-env KEY [KEY...]   — op://$OP_ENV_VAULT/<KEY>/credential を読む (vault の既定は Dev)
# トークンは ~/.config/op/service-account-token (600) に置く。OP_SERVICE_ACCOUNT_TOKEN をグローバルに
# export しないのは、手元で使う op (デスクトップアプリ連携・Personal vault) が Service Account 側に切り替わるため。
set -euo pipefail

[ $# -gt 0 ] || { echo "usage: op-env KEY [KEY...]" >&2; exit 2; }
for key in "$@"; do
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "op-env: キー名が不正: $key" >&2; exit 2; }
done

token_file="${OP_ENV_TOKEN_FILE:-$HOME/.config/op/service-account-token}"
vault="${OP_ENV_VAULT:-Dev}"
[ -r "$token_file" ] || { echo "op-env: トークンが無い: $token_file" >&2; exit 1; }
OP_SERVICE_ACCOUNT_TOKEN="$(cat "$token_file")"
# 空のまま渡すと op がデスクトップアプリ連携 (GUI 承認) に切り替わりうるので止める
[ -n "$OP_SERVICE_ACCOUNT_TOKEN" ] || { echo "op-env: トークンが空: $token_file" >&2; exit 1; }
export OP_SERVICE_ACCOUNT_TOKEN

# .env がシンボリックリンクならリンク先へ書く (worktree 間で共有している .env を切り離さない)
target=.env
if [ -L .env ]; then
  target="$(readlink -f .env)" || { echo "op-env: .env のリンク先が無い — 変更していない" >&2; exit 1; }
fi

umask 077
tmp="$(mktemp "$(dirname "$target")/.env.op-env.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# 既存の .env から、これから書くキーの行だけ除いて引き継ぐ (grep は該当行なしで 1、読めないと 2 を返す)
if [ -e "$target" ]; then
  rc=0
  grep -a -v -E "^(export[[:space:]]+)?($(IFS='|'; echo "$*"))=" "$target" > "$tmp" || rc=$?
  [ "$rc" -le 1 ] || { echo "op-env: .env を読めない — 変更していない" >&2; exit 1; }
fi

# 値はシングルクォートで囲んで書く (zsh の `. .env`・mise・config.fish がどれも文字どおりに読む)。
# シングルクォートと改行はその形で表せない。バックスラッシュは mise が崩す (末尾にあるとパースに失敗し、
# fish へ渡すときに `\\` が `\` になる) ので、これらを含む値は書かない。
missing=() empty=() unquotable=()
nl=$'\n'
for key in "$@"; do
  # 失敗時の op のメッセージには値が含まれないので、そのまま出す
  if ! value="$(op read "op://$vault/$key/credential")"; then
    missing+=("$key")
  elif [ -z "$value" ]; then
    empty+=("$key")
  elif [[ "$value" == *"'"* || "$value" == *"$nl"* || "$value" == *\\* ]]; then
    unquotable+=("$key")
  else
    printf "%s='%s'\n" "$key" "$value" >> "$tmp"
  fi
done

failed=0
[ ${#missing[@]} -eq 0 ] || { echo "op-env: 読めなかったキー (vault: $vault): ${missing[*]}" >&2; failed=1; }
[ ${#empty[@]} -eq 0 ] || { echo "op-env: 値が空のキー: ${empty[*]}" >&2; failed=1; }
[ ${#unquotable[@]} -eq 0 ] || { echo "op-env: シングルクォート・改行・バックスラッシュを含むため書けないキー: ${unquotable[*]}" >&2; failed=1; }
[ "$failed" -eq 0 ] || { echo "op-env: .env は変更していない" >&2; exit 1; }

mv "$tmp" "$target"
chmod 600 "$target"
echo "op-env: .env に書いた: $*"
