#!/usr/bin/env python3
"""保存済み plan の JSON を標準入力から読み、状態と操作の種類だけを検査する。"""
import argparse
import json
import re
import sys


ALLOWED_ACTIONS = (["no-op"], ["read"], ["create"], ["update"])


def rejection(plan):
    if not isinstance(plan, dict):
        return 'plan の JSON オブジェクトではありません'
    version = plan.get('format_version')
    if not isinstance(version, str) or not re.fullmatch(r'1\.\d+', version):
        return '未対応または不明な JSON 形式です'
    if plan.get('errored') is not False:
        return 'plan の正常終了を確認できません'
    if plan.get('complete') is not True:
        return 'plan が不完全、または完了を確認できません'
    if plan.get('applyable') is not True:
        return 'apply 可能な plan ではありません（変更なしの場合も含む）'

    # provider actions は resource_changes に含まれない別の実行なので通さない。
    # https://github.com/hashicorp/terraform/blob/main/internal/command/jsonplan/plan.go
    for field in ('action_invocations', 'deferred_changes', 'deferred_action_invocations'):
        if plan.get(field, []) != []:
            return '未対応の実行操作、または保留された変更があります'

    changes = plan.get('resource_changes', [])
    if not isinstance(changes, list):
        return 'リソースの操作を判定できません'
    for resource in changes:
        if not isinstance(resource, dict) or not isinstance(resource.get('change'), dict):
            return 'リソースの操作を判定できません'
        if resource['change'].get('actions') not in ALLOWED_ACTIONS:
            return '削除・置き換え・state 管理からの除外、または未対応の操作があります'
    return None


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog='終了コード: 0=この検査に合格、1=条件不成立、2=入力エラー。'
               '環境・権限・公開範囲・データ保護は別途確認し、このコマンドだけで apply を許可しない。')
    parser.parse_args()
    try:
        plan = json.load(sys.stdin)
    except (ValueError, OSError, RecursionError):
        # JSON の値やパーサーの例外には秘密値が含まれうるので表示しない。
        print('terraform-plan-check: JSON を読み取れません', file=sys.stderr)
        return 2
    reason = rejection(plan)
    if reason:
        print(f'terraform-plan-check: {reason}', file=sys.stderr)
        return 1
    print('terraform-plan-check: plan の状態・操作の種類は条件に合います。環境と変更の影響は別途確認してください')
    return 0


if __name__ == '__main__':
    sys.exit(main())
