#!/usr/bin/env python3
"""自分が管理する Codex のフックを信頼済みにする。Codex を起動する前に bin/codex が実行する。

Codex はフックの定義やプラグインの中身が変わると、/hooks で承認し直すまでそのフックを動かさない。
未信頼のフックは動かないので、フックの中からは信頼できない。だから起動の前に app-server で信頼する。
信頼するのは、ユーザーのフックとインストール済みのプラグインのフックだけ。プロジェクトのフックは
信頼しない。checkout したブランチのフック（任意のコマンド）が、誰が書いたかを確かめずに動かないようにするため。
"""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import threading

NEEDS_TRUST = {'untrusted', 'modified'}
TRUSTED_SOURCES = {'user', 'plugin'}
TIMEOUT = 10
# フックを使わない呼び出し。Orca が版を確かめるときなどに、承認を書き換えないため。
NO_SESSION_FLAGS = {'-h', '--help', '-V', '--version'}
NO_SESSION_COMMANDS = {'help', 'completion', 'login', 'logout', 'mcp', 'plugin', 'features', 'doctor',
                       'debug', 'update', 'apply', 'a', 'archive', 'unarchive', 'delete', 'app',
                       'migrate-rollouts', 'migrate-nfs-db'}


def classify(hooks):
    """信頼が要るフックを (信頼するもの, 信頼しないもの) に分ける。"""
    pending = [h for h in hooks if h['trustStatus'] in NEEDS_TRUST]
    trust = [h for h in pending if h['source'] in TRUSTED_SOURCES]
    return trust, [h for h in pending if h['source'] not in TRUSTED_SOURCES]


class AppServer:
    def __init__(self, codex):
        self.proc = subprocess.Popen([codex, 'app-server'], stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        self.next_id = 0
        # 応答が無いまま止まっても、codex の起動を待たせ続けない。
        self.timer = threading.Timer(TIMEOUT, self.proc.kill)
        self.timer.daemon = True
        self.timer.start()
        self.request('initialize', {'clientInfo': {'name': 'codex-hook-trust', 'version': '1'}})
        self.send({'method': 'initialized'})

    def send(self, message):
        self.proc.stdin.write(json.dumps(message) + '\n')
        self.proc.stdin.flush()

    def request(self, method, params):
        self.next_id += 1
        self.send({'id': self.next_id, 'method': method, 'params': params})
        for line in self.proc.stdout:
            message = json.loads(line)
            if message.get('id') != self.next_id or 'method' in message:
                continue
            if 'error' in message:
                raise RuntimeError(f"{method}: {message['error']}")
            return message['result']
        raise RuntimeError(f'{method}: app-server が応答せずに終了した')

    def hooks(self, cwd):
        return [h for entry in self.request('hooks/list', {'cwds': [cwd]})['data'] for h in entry['hooks']]

    def close(self):
        self.timer.cancel()
        try:
            self.proc.stdin.close()
            self.proc.wait(timeout=TIMEOUT)
        except (OSError, subprocess.TimeoutExpired):
            self.proc.kill()


def find_codex():
    """PATH 上で、このコマンドと並ぶ bin/codex（ラッパー）でない最初の codex を返す。"""
    wrapper = (Path(__file__).resolve().parent / 'codex').resolve()
    for directory in os.environ.get('PATH', '').split(os.pathsep):
        candidate = Path(directory or '.') / 'codex'
        if candidate.is_file() and os.access(candidate, os.X_OK) and candidate.resolve() != wrapper:
            return str(candidate)
    return None


def starts_session(args):
    """codex の引数が、フックを使うセッションを始めうるなら True。"""
    if args and args[0] in NO_SESSION_COMMANDS:
        return False
    options = args[:args.index('--')] if '--' in args else args
    return not NO_SESSION_FLAGS & set(options)


def codex_cwd(args):
    """codex の引数の -C/--cd を作業ディレクトリとして返す。無ければ今のディレクトリ。

    `codex -C A exec -C B` では Codex と同じく後の B を使う。
    """
    cwd = os.getcwd()
    for i, arg in enumerate(args):
        if arg == '--':
            break
        if arg in ('-C', '--cd') and i + 1 < len(args):
            cwd = os.path.abspath(args[i + 1])
        elif arg.startswith('--cd='):
            cwd = os.path.abspath(arg[len('--cd='):])
        elif arg.startswith('-C') and len(arg) > 2:
            cwd = os.path.abspath(arg[2:].removeprefix('='))
    return cwd


def main(argv):
    """使い方: codex-hook-trust [--codex <本物の codex>] [codex の引数...]"""
    codex = None
    if len(argv) >= 2 and argv[0] == '--codex':
        codex, argv = argv[1], argv[2:]
    if not starts_session(argv):
        return 0
    codex = codex or find_codex()
    if not codex:
        print('codex-hook-trust: codex が PATH に見つからない', file=sys.stderr)
        return 1
    cwd = codex_cwd(argv)
    # app-server は起動したときの config.toml に書き足すので、並行して起動した Orca のワーカーどうしが
    # 互いの承認を上書きする。app-server の起動から確認までを CODEX_HOME ごとに 1 つずつ通す。
    home = Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex')
    home.mkdir(parents=True, exist_ok=True)
    lock = open(home / '.codex-hook-trust.lock', 'w')
    fcntl.flock(lock, fcntl.LOCK_EX)
    server = AppServer(codex)
    try:
        trust, skipped = classify(server.hooks(cwd))
        if trust:
            # upsert は同じキーのほかの項目（enabled など）を残す。プラグインの "宣言/中身" の形の
            # ハッシュは、Codex が trusted_hash と trusted_content_hash に分けて書く。
            value = {h['key']: {'trusted_hash': h['currentHash']} for h in trust}
            server.request('config/batchWrite', {'edits': [
                {'keyPath': 'hooks.state', 'mergeStrategy': 'upsert', 'value': value}]})
            status = {h['key']: h['trustStatus'] for h in server.hooks(cwd)}
            failed = [key for key in value if status.get(key) != 'trusted']
            if failed:
                print(f'codex-hook-trust: 信頼できなかったフック: {", ".join(failed)}', file=sys.stderr)
                return 1
            print(f'codex-hook-trust: フック {len(trust)} 件を信頼した', file=sys.stderr)
        if skipped:
            paths = sorted({h['sourcePath'] for h in skipped})
            print(f'codex-hook-trust: プロジェクトなどのフック {len(skipped)} 件は信頼しなかった'
                  f'（{", ".join(paths)}）。使うなら Codex の /hooks で確かめて承認する', file=sys.stderr)
    finally:
        server.close()
        lock.close()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print(f'codex-hook-trust: フックを信頼できなかった: {error}', file=sys.stderr)
        sys.exit(1)
