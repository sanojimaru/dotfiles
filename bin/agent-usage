#!/usr/bin/env python3
"""Claude/Codex の週枠・短期枠を比較する。ネットワークや認証情報は使わない。"""
import argparse
import fcntl
from datetime import datetime, timezone
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time


def claude_dir():
    return Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude')


def state_dir():
    return claude_dir() / 'agent-usage'


def read_json(path):
    return json.loads(path.read_text())


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.agent-usage-')
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream)
            stream.write('\n')
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def window(value, percent_key):
    if not isinstance(value, dict):
        return None
    used, reset = value.get(percent_key), value.get('resets_at')
    if number(used) and 0 <= used <= 100 and number(reset) and reset > 0:
        return {'used_percent': used, 'resets_at': reset}
    return None


def save_claude(limits):
    state_dir().mkdir(parents=True, exist_ok=True)
    # Concurrent sessions render at once; serialize the read-compare-write.
    with open(state_dir() / '.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for key, filename in [('seven_day', 'claude.json'), ('five_hour', 'claude-five-hour.json')]:
            record = window(limits.get(key), 'used_percentage')
            if not record:
                continue
            try:
                saved = read_json(state_dir() / filename)
            except (OSError, ValueError):
                saved = {}
            # Assume a redraw with an older reset, or a lower value in the same reset, is an
            # idle session's old sample; only a later reset starts a new window.
            if isinstance(saved, dict) and number(saved.get('resets_at')) and number(saved.get('used_percent')):
                if saved['resets_at'] > record['resets_at'] or (
                        saved['resets_at'] == record['resets_at'] and saved['used_percent'] > record['used_percent']):
                    continue
            write_json(state_dir() / filename, {**record, 'observed_at': time.time()})


def capture():
    payload = sys.stdin.buffer.read()
    try:
        limits = json.loads(payload).get('rate_limits') or {}
        # Missing/null windows must not erase the last successful observation.
        if not os.environ.get('CLAUDE_JOB_DIR'):
            save_claude(limits)
    except (ValueError, AttributeError, TypeError, OSError):
        pass
    # Cache failures must not interrupt Orca's statusline or change its input/output.
    try:
        command = read_json(state_dir() / 'delegate.json')['command']
        return subprocess.run(['/bin/sh', '-c', command], input=payload).returncode
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f'agent-usage: Orca コマンドを実行できません: {error}', file=sys.stderr)
        return 1


def install():
    settings_path = claude_dir() / 'settings.json'
    settings = read_json(settings_path)
    status_line = settings.get('statusLine') if isinstance(settings, dict) else None
    if not isinstance(status_line, dict):
        raise ValueError('statusLine が設定されていません。既存の設定は変更しません')
    command = status_line.get('command', '')
    wrapper = '"$HOME/.local/bin/agent-usage" --claude-statusline'
    if command == wrapper:
        print('agent-usage: statusLine は設定済みです')
        return 0
    # Only replace the known Orca setup; leave other user statuslines alone.
    if not isinstance(command, str) or 'agent-hooks/claude-statusline.' not in command:
        raise ValueError('Orca 管理の statusLine がありません。既存の設定は変更しません')
    if not (Path.home() / '.local/bin/agent-usage').is_file():
        raise ValueError('先に agent-usage を ~/.local/bin へリンクしてください')
    write_json(state_dir() / 'delegate.json', {'command': command})
    settings['statusLine'] = {**status_line, 'command': wrapper}
    write_json(settings_path, settings)
    print('agent-usage: 元の Orca コマンドを保存し、使用率の保存を有効にしました')
    return 0


def timestamp(value):
    if not isinstance(value, str):
        raise ValueError('timestamp is missing')
    parsed = datetime.fromisoformat(value.replace('Z', '+00:00'))
    if parsed.tzinfo is None:
        raise ValueError('timestamp has no timezone')
    return parsed.timestamp()


def reversed_lines(path, chunk=1 << 16):
    with path.open('rb') as stream:
        stream.seek(0, os.SEEK_END)
        position, rest = stream.tell(), b''
        while position > 0:
            size = min(chunk, position)
            position -= size
            stream.seek(position)
            lines = (stream.read(size) + rest).split(b'\n')
            rest = lines.pop(0)
            yield from reversed(lines)
        yield rest


def snapshot(line):
    """Return (observed_at, rate_limits) for a usable Codex token_count event, else None."""
    if b'"rate_limits"' not in line:
        return None
    try:
        event = json.loads(line)
        payload = event.get('payload', {})
        limits = payload.get('rate_limits')
        if event.get('type') != 'event_msg' or payload.get('type') != 'token_count':
            return None
        if not isinstance(limits, dict) or limits.get('limit_id') not in (None, 'codex'):
            return None
        # A snapshot without any usable window is not a valid observation.
        if not any(window(limits.get(key), 'used_percent') for key in ('primary', 'secondary')):
            return None
        return timestamp(event.get('timestamp')), limits
    except (ValueError, AttributeError, TypeError):
        return None


def codex_usage():
    root = Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex') / 'sessions'
    files, unreadable = [], False
    for path in root.rglob('*.jsonl'):
        try:
            files.append((path.stat().st_mtime, path))
        except OSError:
            unreadable = True
    best = None
    # Only each file's last snapshot is read. mtime orders and prunes the files;
    # event timestamps decide which snapshot is newest.
    for mtime, path in sorted(files, reverse=True):
        if best and mtime < best[0] - 60:
            break
        try:
            found = next(filter(None, map(snapshot, reversed_lines(path))), None)
        except OSError:
            unreadable = True
            continue
        if found and (not best or found[0] > best[0]):
            best = found
    latest = {}
    if best:
        # Windows are told apart by length, not by primary/secondary position.
        for key in ('primary', 'secondary'):
            raw = best[1].get(key)
            minutes = raw.get('window_minutes') if isinstance(raw, dict) else None
            record = window(raw, 'used_percent')
            if record and number(minutes) and 0 < minutes <= 10080:
                latest[minutes] = {**record, 'observed_at': best[0]}
    return latest, best and best[0], '一部のログを読めません' if unreadable else None


def date_text(value):
    return datetime.fromtimestamp(value, timezone.utc).astimezone().isoformat(timespec='seconds')


def show(name, record, error, max_age):
    if not record:
        print(f'{name}: 取得不可 | 最終取得: 不明 | {error or "枠の記録なし"}')
        return
    observed = record['observed_at']
    age = time.time() - observed
    reasons = []
    if age > max_age:
        reasons.append(f'古い値（{max_age // 60}分超）')
    if record['resets_at'] <= time.time():
        reasons.append('リセット日時経過')
    if age < -60:
        reasons.append('取得日時が未来')
    if error:
        reasons.append(error)
    state = ' / '.join(reasons) or '取得済み'
    print(f'{name}: {record["used_percent"]:g}% | リセット: {date_text(record["resets_at"])}'
          f' | 最終取得: {date_text(observed)} | {state}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--claude-statusline', action='store_true', help='stdin を保存し Orca へ渡す')
    modes.add_argument('--install-claude-statusline', action='store_true', help='既存の Orca statusLine をラップする')
    parser.add_argument('--max-age-minutes', type=int, default=15, help='古い値と表示する経過分数（既定: 15）')
    args = parser.parse_args()
    if args.claude_statusline:
        return capture()
    if args.install_claude_statusline:
        return install()
    if args.max_age_minutes <= 0:
        parser.error('--max-age-minutes は正の整数にしてください')
    for label, filename in [('Claude（週）', 'claude.json'), ('Claude（5時間）', 'claude-five-hour.json')]:
        record, error = None, None
        try:
            raw = read_json(state_dir() / filename)
            record = window(raw, 'used_percent')
            if record is None or not number(raw.get('observed_at')):
                raise ValueError('保存された値が不正です')
            record['observed_at'] = raw['observed_at']
        except (OSError, ValueError, TypeError, AttributeError) as exc:
            record, error = None, str(exc)
        show(label, record, error, args.max_age_minutes * 60)
    records, observed, error = codex_usage()
    # A window absent from the newest snapshot is missing; older snapshots are not mixed in.
    missing = f'最新の記録（{date_text(observed)}）にこの枠なし' if observed else None
    for minutes in sorted(set(records) | {10080, 300}, reverse=True):
        label = '週' if minutes == 10080 else f'{minutes / 60:g}時間'
        record = records.get(minutes)
        show(f'Codex（{label}）', record, error if record else error or missing, args.max_age_minutes * 60)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, OverflowError) as exc:
        print(f'agent-usage: {exc}', file=sys.stderr)
        sys.exit(1)
